# QUARK Environment Variables
# Copy to .env and fill in actual values
# Secrets (passwords/keys) go in secrets/ directory — NOT here

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=info
SECRET_KEY=change-me-in-production

# ── OpenAI / GPT-5.4 ─────────────────────────────────────────────────────────
# Put actual key in secrets/openai_api_key (no newline)
OPENAI_MODEL_DEFAULT=gpt-5.4-nano
OPENAI_MODEL_COMPLEX=gpt-5.4-mini

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=quark-postgres
POSTGRES_PORT=5432
POSTGRES_DB=quark
# Credentials: secrets/postgres_user, secrets/postgres_password

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=quark-redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=86400
# Password: secrets/redis_password

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=quark-mosquitto
MQTT_PORT=1883
MQTT_CLIENT_ID=quark-api
# Credentials: secrets/mqtt_user, secrets/mosquitto_password

# ── Discord Bot ───────────────────────────────────────────────────────────────
# Token: secrets/discord_token
DISCORD_CHANNEL_ID=

# ── Cloudflare ───────────────────────────────────────────────────────────────
# Tunnel token: secrets/cloudflare_tunnel_token

# ── Frontend (Vite build-time) ────────────────────────────────────────────────
VITE_API_URL=https://quark.quoding.com/api
VITE_MQTT_URL=wss://quark.quoding.com:9001
